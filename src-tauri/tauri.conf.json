{
  "version": "2.5.7",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "longDescription": "MuaCloud Native Control Client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources"],
    "publisher": "MuaCloud",
    "externalBin": ["sidecar/muacloud-mihomo", "sidecar/muacloud-mihomo-alpha"],
    "copyright": "GNU General Public License v3.0",
    "category": "DeveloperTool",
    "shortDescription": "MuaCloud Native Control Client",
    "createUpdaterArtifacts": true
  },
  "build": {
    "beforeBuildCommand": "pnpm run web:build",
    "frontendDist": "../dist",
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3100 --strictPort",
    "devUrl": "http://127.0.0.1:3100/",
    "removeUnusedCommands": true
  },
  "productName": "MuaCloud",
  "identifier": "com.muacloud.client",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4NjlGNkM4MzU2ODA5MzkKUldRNUNXZzF5UFpwK0FadFQzVWU4OXpiYk93SW4xS1V2SlVLaDBYcEpiU1RxR3pxWWNRZnpMT0oK",
      "endpoints": ["https://a.4iox.com/update.json"],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["muacloud", "muacloud-client"]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": ["desktop-capability", "migrated"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  }
}
