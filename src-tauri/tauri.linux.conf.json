{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.muacloud.client",
  "bundle": {
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["openssl", "libayatana-appindicator3-1"],
        "desktopTemplate": "./packages/linux/muacloud.desktop",
        "provides": ["muacloud-client"],
        "conflicts": ["muacloud-client"],
        "replaces": ["muacloud-client"],
        "postInstallScript": "./packages/linux/post-install.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      },
      "rpm": {
        "depends": ["openssl", "libayatana-appindicator-gtk3"],
        "desktopTemplate": "./packages/linux/muacloud.desktop",
        "provides": ["muacloud-client"],
        "conflicts": ["muacloud-client"],
        "obsoletes": ["muacloud-client"],
        "postInstallScript": "./packages/linux/post-install.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      }
    },
    "externalBin": [
      "./sidecar/muacloud-service",
      "./sidecar/muacloud-service-install",
      "./sidecar/muacloud-service-uninstall",
      "./sidecar/muacloud-mihomo",
      "./sidecar/muacloud-mihomo-alpha"
    ]
  }
}
